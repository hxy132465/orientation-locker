<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OrientationLocker" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- 方向选择面板：透明背景 + 浮动对话框 -->
    <style name="Theme.OrientationLocker.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>
</resources>
