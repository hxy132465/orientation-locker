<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      原生 Material 主题（不依赖 AppCompat）：
      省掉 appcompat 的整套资源与类，冷启动更快、包体更小。
    -->
    <style name="Theme.OrientationLocker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 方向选择面板：透明背景 + 浮动对话框 -->
    <style name="Theme.OrientationLocker.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@style/Animation.OrientationLocker.Dialog</item>
    </style>
</resources>
