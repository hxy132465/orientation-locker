<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_padding_h"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingRight="@dimen/page_padding_h"
        android:paddingBottom="@dimen/page_padding_bottom">

        <TextView
            android:id="@+id/titleText"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/app_subtitle" />

        <!-- 状态卡 -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/statusHeadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/modeChip"
                    style="@style/Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDetail"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="@string/section_environment" />

        <!-- Shizuku -->
        <LinearLayout
            android:id="@+id/rowShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_item"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@string/action_shizuku"
                android:padding="9dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/row_shizuku" />

                <TextView
                    android:id="@+id/shizukuState"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/state_checking" />
            </LinearLayout>

            <TextView
                android:id="@+id/shizukuAction"
                style="@style/Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_action"
                android:textColor="@color/accent_text" />
        </LinearLayout>

        <!-- 悬浮窗 -->
        <LinearLayout
            android:id="@+id/rowOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_item"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@string/row_overlay"
                android:padding="9dp"
                android:src="@drawable/ic_layers"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/row_overlay" />

                <TextView
                    android:id="@+id/overlayState"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/state_checking" />
            </LinearLayout>

            <TextView
                android:id="@+id/overlayAction"
                style="@style/Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_action"
                android:textColor="@color/accent_text" />
        </LinearLayout>

        <!-- 修改系统设置 -->
        <LinearLayout
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_item"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@string/row_settings"
                android:padding="9dp"
                android:src="@drawable/ic_sliders"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/row_settings" />

                <TextView
                    android:id="@+id/settingsState"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/state_checking" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsAction"
                style="@style/Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_action"
                android:textColor="@color/accent_text" />
        </LinearLayout>

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="@string/section_quick_lock" />

        <!-- 方向网格 2×2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_item"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tilePortrait"
                style="@style/OrientationTile">

                <ImageView
                    style="@style/OrientationTileIcon"
                    android:contentDescription="@string/orientation_portrait"
                    android:src="@drawable/ic_orientation_portrait" />

                <TextView
                    style="@style/OrientationTileLabel"
                    android:text="@string/orientation_portrait" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/tileLandscape"
                style="@style/OrientationTile">

                <ImageView
                    style="@style/OrientationTileIcon"
                    android:contentDescription="@string/orientation_landscape"
                    android:src="@drawable/ic_orientation_landscape" />

                <TextView
                    style="@style/OrientationTileLabel"
                    android:text="@string/orientation_landscape" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileReversePortrait"
                style="@style/OrientationTile">

                <ImageView
                    style="@style/OrientationTileIcon"
                    android:contentDescription="@string/orientation_reverse_portrait"
                    android:rotation="180"
                    android:src="@drawable/ic_orientation_portrait" />

                <TextView
                    style="@style/OrientationTileLabel"
                    android:text="@string/orientation_reverse_portrait" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/tileReverseLandscape"
                style="@style/OrientationTile">

                <ImageView
                    style="@style/OrientationTileIcon"
                    android:contentDescription="@string/orientation_reverse_landscape"
                    android:rotation="180"
                    android:src="@drawable/ic_orientation_landscape" />

                <TextView
                    style="@style/OrientationTileLabel"
                    android:text="@string/orientation_reverse_landscape" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/unlockButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/action_unlock"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hint_footer" />
    </LinearLayout>
</ScrollView>
